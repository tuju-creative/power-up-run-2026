#!/usr/bin/env sh
# Full-page headless Chrome screenshots at 320/375/768/1440 into tmp/screenshots/, with
# horizontal-overflow and console-error checks (non-zero exit on failure). Real-time capture
# over the DevTools protocol so scroll reveals fire. Needs Google Chrome and Node 22 (via mise).
#   bin/screenshots                 all widths
#   bin/screenshots --no-js         with JavaScript disabled (files end _nojs)
#   bin/screenshots --reduce        with prefers-reduced-motion: reduce (files end _reduce)
#   bin/screenshots --widths=375,1440
cd "$(dirname "$0")/.." || exit 1
exec mise exec node@22.21.0 -- node bin/screenshots.mjs "$@"
